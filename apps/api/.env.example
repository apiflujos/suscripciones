NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://wompi_subs:wompi_subs@localhost:5432/wompi_subs?schema=public

# Wompi: secreto para validar firma de eventos/webhooks (ENV o guardado en DB desde Admin)
WOMPI_EVENTS_SECRET=

# Wompi API (ENV o guardado en DB desde Admin)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_LINK_BASE_URL=https://checkout.wompi.co/l/
WOMPI_REDIRECT_URL=

# Admin API auth (Bearer)
ADMIN_API_TOKEN=change-me-change-me
ADMIN_SESSION_SECRET=change-me-change-me

# TTL sesión Super Admin (en horas)
SA_SESSION_TTL_HOURS=24

# Reenvío opcional a tu tienda (endpoint propio tuyo / app / server)
SHOPIFY_FORWARD_URL=
SHOPIFY_FORWARD_SECRET=
SHOPIFY_FORWARD_ORIGIN=shopify
SHOPIFY_FORWARD_RETRY_ENABLED=true
SHOPIFY_FORWARD_RETRY_MINUTES=15

# Base64(32 bytes) para cifrar secretos guardados en DB (credentials)
CREDENTIALS_ENCRYPTION_KEY_B64=

# Chatwoot (opcional; no requiere WhatsApp Business API)
CHATWOOT_ACTIVE_ENV=PRODUCTION
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_INBOX_ID=
CHATWOOT_WEBHOOK_TOKEN=

# Wompi env selector (PRODUCTION | SANDBOX)
WOMPI_ACTIVE_ENV=SANDBOX

# URLs externas (opcionales)
APP_HOST=
# Base publica fija para links del checkout (plan/suscripcion)
APP_PUBLIC_BASE_URL=

# CORS
CORS_ORIGINS=

# CSP (solo habilitar unsafe-inline en desarrollo si es estrictamente necesario)
CSP_ALLOW_UNSAFE_INLINE=0

# Trust proxy (Render/Cloudflare suele ser 1)
TRUST_PROXY=1

# Rate limiting
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=600

# Logs
SYSTEM_LOG_RETENTION_DAYS=30

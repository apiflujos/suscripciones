# Configuración consolidada (Next.js Admin + API + Webhooks + WS)
# Copia este archivo a `.env` y ajusta valores.

# -----------------
# Backend (Next.js route handlers) - REQUERIDOS
# -----------------
DATABASE_URL=postgresql://wompi_subs:wompi_subs@localhost:5433/wompi_subs?schema=public
PORT=3002
NODE_ENV=production

# Secreto de sesión (Firma de cookies) - REQUERIDO
# Generar: openssl rand -base64 32
ADMIN_SESSION_SECRET=generar-un-secreto-largo-y-seguro

# Token de seguridad para comunicación interna - REQUERIDO
 # Debe ser igual en admin + jobs
ADMIN_API_TOKEN=change-me-change-me

# -----------------
# JWT (Auth Global) - REQUERIDOS
# -----------------
# HS256 secret (min 32 bytes). Si usas RS256, define JWT_PUBLIC_KEY/JWT_PRIVATE_KEY
# Generar: openssl rand -base64 32
JWT_SECRET=generar-secreto-jwt-largo
JWT_ISSUER=suscripciones
JWT_AUDIENCE=admin
# TTL en segundos (15-30 min recomendado)
JWT_TTL_SECONDS=1800
# Refresh tokens rotativos
JWT_REFRESH_TTL_DAYS=14
JWT_REFRESH_ROTATE=1
# Token extra para habilitar /admin/auth/login y /admin/sa/* (opcional)
BOOTSTRAP_TOKEN=

# -----------------
# Super Admin bootstrap (RECOMENDADO)
# Se crea automáticamente al arrancar si no existe
# -----------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Poner en 1 solo si deseas forzar reset de contraseña en cada arranque
SUPER_ADMIN_RESET_PASSWORD=0
# (Opcional) Asignar tenant inicial
SUPER_ADMIN_TENANT_ID=
# Tenant por defecto (backfill/lectura)
DEFAULT_TENANT_NAME=apiflujos
# TTL de sesión Super Admin (en horas)
SA_SESSION_TTL_HOURS=24
# TTL refresh token (en días)
SA_REFRESH_TTL_DAYS=14
# Renovación deslizante de sesión (0 = off)
SA_SESSION_ROLLING=1
# Máximo de vida de la sesión (en días) cuando rolling está activo
SA_SESSION_MAX_DAYS=7

# -----------------
# Wompi (OPCIONAL - puedes configurar desde /settings)
# -----------------
WOMPI_EVENTS_SECRET=
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_BASE_URL=https://production.wompi.co/v1
WOMPI_ACTIVE_ENV=PRODUCTION

# -----------------
# Encriptación de secretos en DB (RECOMENDADO)
# Base64 de 32 bytes
# Ejemplo: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY_B64=

# CSP (solo habilitar unsafe-inline en desarrollo si es estrictamente necesario)
CSP_ALLOW_UNSAFE_INLINE=0
# CSP (habilita unsafe-inline solo en rutas public para Wompi)
CSP_PUBLIC_ALLOW_UNSAFE_INLINE=0

# CORS (orígenes permitidos, separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3000

# Security headers
SECURITY_HEADERS_ENABLED=1
HSTS_MAX_AGE=63072000

# Trust proxy (Render/Cloudflare suele ser 1)
TRUST_PROXY=1

# Rate limiting
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=600
# Upstash Redis (rate limit distribuido)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------
# Realtime publish (para jobs/worker)
# -----------------
REALTIME_PUBLISH_URL=http://localhost:3002/api/realtime/publish
REALTIME_PUBLISH_TOKEN=
RATE_LIMIT_STORE=memory

# Audit logs (retención en días)
AUDIT_LOG_RETENTION_DAYS=60

# Jobs runner heartbeat
JOBS_HEARTBEAT_KEY=wompi-subs-jobs
JOBS_HEARTBEAT_SECONDS=60
JOBS_HEALTH_TTL_SECONDS=180

# Gamificación
GAMIFICATION_RECALC_MINUTES=60

# Entrenadores de datos (followups Chatwoot)
DATA_TRAINER_MINUTES=15
CHATWOOT_FOLLOWUP_MINUTES=15
CHATWOOT_FOLLOWUP_COOLDOWN_MINUTES=120
CHATWOOT_FOLLOWUP_MAX_CUSTOMERS=200
CHATWOOT_FOLLOWUP_MAX_ATTEMPTS=3

# -----------------
# Frontend (misma app)
# -----------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002
# Soporte checkout público
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@tu-dominio.com
NEXT_PUBLIC_SUPPORT_URL=https://wa.me/57XXXXXXXXXX

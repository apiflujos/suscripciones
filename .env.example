# Configuración consolidada para despliegue PM2 (Copia estos valores a apps/api/.env y apps/admin/.env.local)

# -----------------
# API (apps/api/.env)
# -----------------
DATABASE_URL=postgresql://user:pass@localhost:5432/wompi_subs?schema=public
PORT=3001
NODE_ENV=production

# Secreto de sesión (Firma de cookies)
ADMIN_SESSION_SECRET=generar-un-secreto-largo-y-seguro

# Token de seguridad para comunicación interna entre Admin y API
ADMIN_API_TOKEN=change-me-change-me

# Super Admin bootstrap (se crea automáticamente al arrancar si no existe)
SUPER_ADMIN_EMAIL=comercial@apiflujos.com
SUPER_ADMIN_PASSWORD=Apiflujos2026*
# Poner en 1 solo si deseas forzar reset de contraseña en cada arranque
SUPER_ADMIN_RESET_PASSWORD=0
# (Opcional) Asignar tenant inicial
SUPER_ADMIN_TENANT_ID=

# Wompi (puedes dejarlas vacías si las configurarás desde el panel Admin en /settings)
WOMPI_EVENTS_SECRET=
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_BASE_URL=https://production.wompi.co/v1
WOMPI_ACTIVE_ENV=PRODUCTION

# Encriptación de secretos en DB (Base64 de 32 bytes)
# Ejemplo: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY_B64=

# -----------------
# Admin (apps/admin/.env.local)
# -----------------
NEXT_PUBLIC_API_BASE_URL=https://tu-dominio.com
ADMIN_API_TOKEN=change-me-change-me (debe coincidir con el del API)
ADMIN_SESSION_SECRET=generar-un-secreto-largo-y-seguro
PORT=10000

# Soporte checkout público
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@tu-dominio.com
NEXT_PUBLIC_SUPPORT_URL=https://wa.me/57XXXXXXXXXX

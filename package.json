{
  "name": "wompi-subs",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/admin",
    "dev:admin": "npm run dev -w apps/admin",
    "build": "npm run build -w apps/admin",
    "build:admin": "npm run build -w apps/admin",
    "start": "npm run start -w apps/admin",
    "lint": "npm run lint -w apps/admin",
    "typecheck": "npm run typecheck -w packages/core && npm run typecheck -w apps/admin && npm run build -w apps/worker",
    "postinstall": "node -e \"const f=require('fs');if(!f.existsSync('packages/database/prisma/schema.prisma'))process.exit(0);try{require('child_process').execSync('npm run prisma:generate -w packages/database',{stdio:'inherit'})}catch(e){console.warn('[postinstall] Genera el cliente con: npm run db:generate')}\"",
    "test": "vitest run --pool=threads --maxWorkers=1 --minWorkers=1",
    "test:watch": "vitest",
    "jobs": "npm -w apps/worker run start",
    "db:generate": "npm run prisma:generate -w packages/database",
    "db:migrate": "npm run prisma:migrate:dev -w packages/database",
    "db:push": "npm run prisma:push -w packages/database",
    "db:studio": "npm run prisma:studio -w packages/database",
    "migrate:mdv-curated": "node packages/core/src/scripts/migrate-mdv-abril2026.js",
    "reset:mdv-curated": "node packages/core/src/scripts/reset-mdv-curated.js",
    "check:jobs": "node --env-file=.env scripts/check-jobs.mjs",
    "audit:product-plan-mapping": "npx tsx packages/core/src/scripts/audit-product-plan-mapping.ts",
    "repair:subscriptions": "npx tsx packages/core/src/scripts/repair-subscriptions.ts",
    "repair:duplicate-customers": "npx tsx packages/core/src/scripts/merge-duplicate-customers.ts",
    "repair:skipped-cycles": "npx tsx packages/core/src/scripts/repair-skipped-cycles.ts",
    "repair:paid-cycles": "npx tsx packages/core/src/scripts/repair-paid-cycles-without-payment.ts",
    "seed:bootstrap": "node scripts/seed_bootstrap.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:local": "node scripts/seed_local.js",
    "audit": "npm audit --audit-level=high",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "typecheck:admin": "npm run typecheck -w apps/admin",
    "typecheck:core": "npm run typecheck -w packages/core"
  },
  "prisma": {
    "seed": "npm run seed:bootstrap"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.8.0",
    "vitest": "^2.1.8",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.2"
}

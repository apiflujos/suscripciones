# Docker Compose - Variables de Entorno
# Copia este archivo a .env y completa con tus valores reales

# ======================
# BASE DE DATOS
# ======================
POSTGRES_USER=wompi_subs
POSTGRES_PASSWORD=cambia-esta-contraseña-segura-123

# ======================
# API
# ======================
NODE_ENV=development
ADMIN_API_TOKEN=genera-un-token-seguro-aqui
ADMIN_SESSION_SECRET=genera-un-secreto-largo-y-seguro

# Super Admin (se crea automáticamente)
SUPER_ADMIN_EMAIL=tu-email@empresa.com
SUPER_ADMIN_PASSWORD=Contraseña-Segura-123!
SUPER_ADMIN_RESET_PASSWORD=0
SUPER_ADMIN_TENANT_ID=
DEFAULT_TENANT_NAME=apiflujos

# Encriptación de secretos (Base64 de 32 bytes)
# Generar con: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY_B64=

# ======================
# WOMPI (Opcional - se puede configurar desde /settings)
# ======================
WOMPI_EVENTS_SECRET=
WOMPI_PRIVATE_KEY=
WOMPI_PUBLIC_KEY=
WOMPI_API_BASE_URL=https://production.wompi.co/v1
WOMPI_ACTIVE_ENV=PRODUCTION

# ======================
# ADMIN
# ======================
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_DISABLE_REALTIME=1

# ======================
# CHATWOOT (Opcional)
# ======================
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACTIVE_ENV=PRODUCTION

# Docker Compose - Variables de Entorno
# Copia este archivo a .env y completa con tus valores reales
# Luego ejecuta: docker-compose up -d

# ======================
# BASE DE DATOS
# ======================
POSTGRES_USER=wompi_subs
POSTGRES_PASSWORD=cambia-esta-contraseña-segura-123

# ======================
# API y ADMIN (DEBEN COINCIDIR)
# ======================
# IMPORTANTE: Estos valores deben ser IGUALES en ambos servicios
ADMIN_API_TOKEN=genera-un-token-seguro-aqui-usa-lo-mismo-en-ambos
ADMIN_SESSION_SECRET=genera-un-secreto-largo-y-seguro-mismo-en-ambos
JWT_SECRET=generar-secreto-jwt-largo
JWT_ISSUER=suscripciones
JWT_AUDIENCE=admin
JWT_TTL_SECONDS=1800
JWT_REFRESH_TTL_DAYS=14
JWT_REFRESH_ROTATE=1
BOOTSTRAP_TOKEN=
REALTIME_PUBLISH_TOKEN=
REALTIME_PUBLISH_URL=http://admin:3002/api/realtime/publish

# ======================
# SUPER ADMIN (Se crea automáticamente)
# ======================
SUPER_ADMIN_EMAIL=tu-email@empresa.com
SUPER_ADMIN_PASSWORD=Contraseña-Segura-123!
SUPER_ADMIN_RESET_PASSWORD=0
SUPER_ADMIN_TENANT_ID=
DEFAULT_TENANT_NAME=apiflujos

# ======================
# ENCRIPTACIÓN
# ======================
# Encriptación de secretos en DB (Base64 de 32 bytes)
# Generar con: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY_B64=

# ======================
# WOMPI (Opcional - se puede configurar desde /settings)
# ======================
WOMPI_EVENTS_SECRET=
WOMPI_PRIVATE_KEY=
WOMPI_PUBLIC_KEY=
WOMPI_API_BASE_URL=https://production.wompi.co/v1
WOMPI_ACTIVE_ENV=PRODUCTION

# ======================
# ADMIN
# ======================
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002
NEXT_PUBLIC_DISABLE_REALTIME=0

# ======================
# CHATWOOT (Opcional)
# ======================
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACTIVE_ENV=PRODUCTION

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
  SUSPENDED
}

enum PlanIntervalUnit {
  DAY
  WEEK
  MONTH
  CUSTOM
}

enum PlanType {
  manual_link
  auto_subscription
}

enum PublicCheckoutKind {
  PLAN
  SUBSCRIPTION
  CART
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  ERROR
  VOIDED
}

enum PaymentLinkStatus {
  SENT
  PAID
  FAILED
}

enum PaymentOrigin {
  AUTO_DEBIT
  AUTO_LINK
  MANUAL_LINK
  MANUAL_USER
  WEBHOOK
}

enum PaymentAssociationReason {
  LINK_MATCH
  TX_MATCH
  REF_MATCH
  SUB_REF
  IDENTITY_MATCH
  MANUAL_RECONCILE
  UNLINKED
  UNKNOWN
}

enum PaymentTiming {
  EN_CURSO
  ANTICIPADO
}

enum BillingCycleStatus {
  PENDING
  PAID
  FAILED
  SKIPPED
}

enum SmartViewVisibility {
  PRIVATE
  ORG
}

enum SmartViewType {
  DYNAMIC
  STATIC
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum CampaignSendStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum WebhookProvider {
  WOMPI
  CUSTOM
  MERCADOPAGO
}

enum WebhookProcessStatus {
  RECEIVED
  PROCESSED
  FAILED
  SKIPPED
}

enum ChatwootMessageType {
  PAYMENT_LINK
  PAYMENT_CONFIRMED
  EXPIRY_WARNING
  PAYMENT_FAILED
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum CredentialProvider {
  WOMPI
  CHATWOOT
  SHOPIFY
  OPENAI
  DEEPSEEK
  GAMIFICATION
}

enum RetryJobType {
  PROCESS_WOMPI_EVENT
  FORWARD_WOMPI_TO_SHOPIFY
  SEND_CHATWOOT_MESSAGE
  SUBSCRIPTION_REMINDER
  PAYMENT_RETRY
  BILLING_MONTHLY_REPORT
  SEND_CAMPAIGN
  SYNC_SMART_LISTS
  AI_ASSIST
  GAMIFICATION_RECALC
  DATA_TRAINER
}

enum RetryJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum SaUserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
}

enum SaPeriodType {
  monthly
  total
}

enum SaPlanKind {
  MASTER
  PRO
  ON_DEMAND
}

enum GamificationEntityType {
  CUSTOMER
  PRODUCT
  PLAN
  SUBSCRIPTION
  JOB
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  name      String?
  email     String?  @unique
  phone     String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        SaTenant?       @relation(fields: [tenantId], references: [id])
  subscriptions Subscription[]
  payments      Payment[]
  chatwootMsgs  ChatwootMessage[]
  smartListMembers SmartListMember[]
  campaignSends    CampaignSend[]
  tenantLinks   CustomerTenant[]

  @@index([tenantId])
}

model Empresa {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String?   @db.Uuid
  nombre               String
  email                String?
  telefono             String?
  direccion            String?
  sitioWeb             String?
  contactoPrincipalId  String?   @unique @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant              SaTenant? @relation(fields: [tenantId], references: [id])
  contactos           Contacto[]
  contactoPrincipal   Contacto? @relation("EmpresaContactoPrincipal", fields: [contactoPrincipalId], references: [id])
  subscriptions       Subscription[]

  @@index([tenantId])
  @@index([contactoPrincipalId])
}

model Contacto {
  id         String    @id @default(uuid()) @db.Uuid
  empresaId  String    @db.Uuid
  nombre     String
  email      String?
  telefono   String?
  cargo      String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  principalDe Empresa? @relation("EmpresaContactoPrincipal")
  subscriptions Subscription[]

  @@index([empresaId])
}

model SubscriptionPlan {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String?          @db.Uuid
  name         String           @unique
  priceInCents Int
  currency     String           @default("COP")
  intervalUnit PlanIntervalUnit
  intervalCount Int             @default(1)
  planType     PlanType         @default(manual_link)
  active       Boolean          @default(true)
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant        SaTenant?       @relation(fields: [tenantId], references: [id])
  tenantLinks   SubscriptionPlanTenant[]
  subscriptions Subscription[]
  paymentLinks  PaymentLink[]

  @@index([tenantId])
}

model PublicCheckoutTemplate {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @db.Uuid
  name             String
  kind             PublicCheckoutKind
  active           Boolean             @default(true)
  allowProductSelect Boolean           @default(false)
  productIds       Json?
  expiryHours      Int?
  logoUrl          String?
  publicTitle      String?
  publicDescription String?
  wompiTitle       String?
  wompiDescription String?
  utmParams        String?
  layout           Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant SaTenant @relation(fields: [tenantId], references: [id])
  @@index([active, kind])
  @@index([tenantId])
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @db.Uuid
  customerId           String             @db.Uuid
  empresaId            String?            @db.Uuid
  contactoId           String?            @db.Uuid
  planId               String             @db.Uuid
  status               SubscriptionStatus @default(ACTIVE)
  startAt              DateTime           @default(now())
  currentPeriodStartAt DateTime           @default(now())
  currentPeriodEndAt   DateTime
  currentCycle         Int                @default(1)
  cycleStartDay         Int               @default(1)
  paymentDay            Int               @default(1)
  paymentTiming         PaymentTiming     @default(EN_CURSO)
  graceDays             Int               @default(1)
  retryCount           Int                @default(0)
  maxRetries           Int                @default(3)
  canceledAt           DateTime?
  suspendedAt          DateTime?
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant        SaTenant        @relation(fields: [tenantId], references: [id])
  tenantLinks   SubscriptionTenant[]
  customer      Customer        @relation(fields: [customerId], references: [id])
  empresa       Empresa?         @relation(fields: [empresaId], references: [id])
  contacto      Contacto?        @relation(fields: [contactoId], references: [id])
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
  payments      Payment[]
  billingCycles SubscriptionBillingCycle[]
  chatwootMsgs  ChatwootMessage[]
  paymentLinks  PaymentLink[]

  @@index([status, currentPeriodEndAt])
  @@index([customerId])
  @@index([empresaId])
  @@index([contactoId])
  @@index([planId])
  @@index([tenantId])
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @db.Uuid
  customerId         String        @db.Uuid
  subscriptionId     String?       @db.Uuid
  paymentLink        PaymentLink?
  amountInCents      Int
  currency           String        @default("COP")
  cycleNumber        Int?
  reference          String
  wompiTransactionId String?
  wompiPaymentLinkId String?       @unique
  checkoutUrl        String?
  subscriptionCycleKey String?     @unique
  status             PaymentStatus @default(PENDING)
  paidAt             DateTime?
  failedAt           DateTime?
  origin             PaymentOrigin @default(WEBHOOK)
  associationReason  PaymentAssociationReason?
  associatedBy       String?
  providerResponse   Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant       SaTenant    @relation(fields: [tenantId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  attempts     PaymentAttempt[]
  chatwootMsgs ChatwootMessage[]
  billingCycle SubscriptionBillingCycle?

  @@unique([wompiTransactionId])
  @@index([reference])
  @@index([subscriptionId, status])
  @@index([status, createdAt])
  @@index([tenantId])
}

model SubscriptionBillingCycle {
  id                String              @id @default(uuid()) @db.Uuid
  subscriptionId    String              @db.Uuid
  cycleNumber       Int
  periodStartAt     DateTime
  periodEndAt       DateTime
  dueAt             DateTime
  status            BillingCycleStatus  @default(PENDING)
  paidAt            DateTime?
  paymentId         String?             @unique @db.Uuid
  paidOnTime        Boolean?
  daysEarly         Int?
  daysLate          Int?
  origin            PaymentOrigin?
  associationReason PaymentAssociationReason?
  associatedBy      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  @@unique([subscriptionId, cycleNumber])
  @@index([subscriptionId, periodStartAt])
  @@index([subscriptionId, paymentId])
}

model PaymentLink {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  planId           String   @db.Uuid
  subscriptionId   String   @db.Uuid
  paymentId        String   @unique @db.Uuid
  wompiPaymentLinkId String @unique
  checkoutUrl      String
  status           PaymentLinkStatus   @default(SENT)
  sentAt           DateTime @default(now())
  paidAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       SaTenant        @relation(fields: [tenantId], references: [id])
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  subscription Subscription     @relation(fields: [subscriptionId], references: [id])
  payment      Payment          @relation(fields: [paymentId], references: [id])

  @@index([planId, sentAt])
  @@index([subscriptionId, sentAt])
  @@index([sentAt])
  @@index([tenantId])
}

model PaymentAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @db.Uuid
  attemptNo   Int
  status      String
  errorCode   String?
  errorMessage String?
  provider    String?
  response    Json?
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model WebhookEvent {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  provider      WebhookProvider
  checksum      String               @unique
  eventName     String
  providerTs    BigInt?
  headers       Json?
  payload       Json
  receivedAt    DateTime             @default(now())
  processedAt   DateTime?
  processStatus WebhookProcessStatus @default(RECEIVED)
  errorMessage  String?

  tenant SaTenant @relation(fields: [tenantId], references: [id])
  @@index([provider, receivedAt])
  @@index([processStatus, receivedAt])
  @@index([receivedAt])
  @@index([tenantId])
}

model WebhookEndpoint {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @db.Uuid
  provider   WebhookProvider
  name       String
  path       String          @unique
  secretHash String
  secretSalt String
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  tenant SaTenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([provider])
}

model ChatwootMessage {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  customerId     String            @db.Uuid
  subscriptionId String?           @db.Uuid
  paymentId      String?           @db.Uuid
  type           ChatwootMessageType
  status         MessageStatus     @default(PENDING)
  to             String?
  content        String
  providerResp   Json?
  errorMessage   String?
  sentAt         DateTime?
  actor          String?
  createdAt      DateTime          @default(now())

  tenant       SaTenant    @relation(fields: [tenantId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  payment      Payment?      @relation(fields: [paymentId], references: [id])

  @@index([status, createdAt])
  @@index([customerId])
  @@index([tenantId])
  @@index([actor, createdAt])
}

model ReportCache {
  id          String   @id @default(uuid()) @db.Uuid
  reportKey   String
  tenantId    String   @db.Uuid
  from        DateTime
  to          DateTime
  granularity String?
  filtersHash String?
  version     String?
  payload     Json
  computedAt  DateTime @default(now())
  expiresAt   DateTime
  staleAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reportKey, tenantId])
  @@index([expiresAt])
  @@unique([reportKey, tenantId, from, to, granularity, filtersHash, version])
}

model SmartList {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  name          String   @unique
  description   String?
  enabled       Boolean  @default(true)
  rules         Json
  chatwootLabel String   @unique
  lastRunAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    SaTenant @relation(fields: [tenantId], references: [id])
  campaigns Campaign[]
  members   SmartListMember[]

  @@index([enabled, createdAt])
  @@index([tenantId])
}

model SmartView {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  name           String
  scope          String
  visibility     SmartViewVisibility @default(ORG)
  type           SmartViewType       @default(DYNAMIC)
  filters        Json?
  staticCount    Int                 @default(0)
  createdByEmail String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant SaTenant      @relation(fields: [tenantId], references: [id])
  items  SmartViewItem[]
  campaigns Campaign[]

  @@index([tenantId, scope, visibility])
  @@index([tenantId, scope])
}

model SmartViewItem {
  id          String   @id @default(uuid()) @db.Uuid
  smartViewId String   @db.Uuid
  itemId      String
  createdAt   DateTime @default(now())

  smartView SmartView @relation(fields: [smartViewId], references: [id], onDelete: Cascade)

  @@unique([smartViewId, itemId])
  @@index([itemId])
}

model SmartListMember {
  id          String   @id @default(uuid()) @db.Uuid
  smartListId String   @db.Uuid
  customerId  String   @db.Uuid
  active      Boolean  @default(true)
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  smartList SmartList @relation(fields: [smartListId], references: [id])
  customer  Customer  @relation(fields: [customerId], references: [id])

  @@unique([smartListId, customerId])
  @@index([active, updatedAt])
}

model Campaign {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @db.Uuid
  name          String
  smartListId   String?          @db.Uuid
  smartViewId   String?          @db.Uuid
  smartViewFilters Json?
  status        CampaignStatus   @default(DRAFT)
  content       String
  templateParams Json?
  startedAt     DateTime?
  completedAt   DateTime?
  lastError     String?
  sentCount     Int              @default(0)
  failedCount   Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant     SaTenant      @relation(fields: [tenantId], references: [id])
  smartList  SmartList?     @relation(fields: [smartListId], references: [id])
  smartView  SmartView?     @relation(fields: [smartViewId], references: [id])
  recipients CampaignSend[]

  @@index([status, createdAt])
  @@index([smartListId])
  @@index([smartViewId])
  @@index([tenantId])
}

model CampaignSend {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  campaignId  String             @db.Uuid
  customerId  String             @db.Uuid
  status      CampaignSendStatus @default(PENDING)
  sentAt      DateTime?
  errorMessage String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant   SaTenant @relation(fields: [tenantId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([campaignId, customerId])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([tenantId])
}

model CustomerTenant {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  tenantId   String   @db.Uuid
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   SaTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([customerId, tenantId])
  @@index([tenantId])
}

model SubscriptionPlanTenant {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @db.Uuid
  tenantId  String   @db.Uuid
  createdAt DateTime @default(now())

  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  tenant SaTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([planId, tenantId])
  @@index([tenantId])
}

model SubscriptionTenant {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @db.Uuid
  tenantId       String   @db.Uuid
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant       SaTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, tenantId])
  @@index([tenantId])
}

model SystemLog {
  id        String   @id @default(uuid()) @db.Uuid
  level     LogLevel
  source    String
  message   String
  context   Json?
  actor     String?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([actor, createdAt])
}

model GamificationEvent {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String?                @db.Uuid
  entityType    GamificationEntityType
  entityId      String                 @db.Uuid
  kind          String
  statusDelta   Int                    @default(0)
  lifetimeDelta Int                    @default(0)
  rewardDelta   Int                    @default(0)
  moneyInCents  Int?
  metadata      Json?
  createdAt     DateTime               @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([kind, createdAt])
}

model GamificationScore {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String?                @db.Uuid
  entityType         GamificationEntityType
  entityId           String                 @db.Uuid
  lifetimePoints     Int                    @default(0)
  statusScore        Int                    @default(0)
  level              Int                    @default(1)
  lastActivityAt     DateTime?
  lastPaymentAt      DateTime?
  lastDecayAt        DateTime?
  streakMonths       Int                    @default(0)
  dataQualityScore   Int                    @default(0)
  recencyScore       Int                    @default(0)
  monetaryScore      Int                    @default(0)
  activityScore      Int                    @default(0)
  consistencyScore   Int                    @default(0)
  penaltyScore       Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, entityType, level])
  @@index([entityType, statusScore])
}

model GamificationRewardLedger {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @db.Uuid
  tenantId       String?  @db.Uuid
  eventId        String?  @db.Uuid
  pointsEarned   Int      @default(0)
  pointsRedeemed Int      @default(0)
  balance        Int      @default(0)
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([tenantId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model ServiceHeartbeat {
  key        String   @id
  lastSeenAt DateTime
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Credential {
  id            String             @id @default(uuid()) @db.Uuid
  provider      CredentialProvider
  key           String
  valueEncrypted String
  version       Int                @default(1)
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([provider, key])
}

model RetryJob {
  id          String        @id @default(uuid()) @db.Uuid
  type        RetryJobType
  status      RetryJobStatus @default(PENDING)
  runAt       DateTime      @default(now())
  attempts    Int           @default(0)
  maxAttempts Int           @default(10)
  lastError   String?
  payload     Json
  lockedAt    DateTime?
  lockedBy    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, runAt])
  @@index([type, status])
}

model SaTenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  active    Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      SaUser[]
  userLinks  SaUserTenant[]
  planLinks  SubscriptionPlanTenant[]
  subscriptionLinks SubscriptionTenant[]
  planSnaps  SaTenantPlanSnapshot[]
  modules    SaTenantModuleToggle[]
  usageEvents SaUsageEvent[]
  usageCounters SaUsageCounter[]
  billingEvents SaBillingEvent[]
  billingCounters SaBillingCounter[]
  customers Customer[]
  plans SubscriptionPlan[]
  checkoutTemplates PublicCheckoutTemplate[]
  subscriptions Subscription[]
  payments Payment[]
  paymentLinks PaymentLink[]
  empresas Empresa[]
  webhookEvents WebhookEvent[]
  webhookEndpoints WebhookEndpoint[]
  apiTokens ApiToken[]
  chatwootMessages ChatwootMessage[]
  smartLists SmartList[]
  smartViews SmartView[]
  campaigns Campaign[]
  campaignSends CampaignSend[]
  customerLinks CustomerTenant[]
}

model SaUser {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String?    @db.Uuid
  email        String
  passwordHash String
  role         SaUserRole
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant SaTenant? @relation(fields: [tenantId], references: [id])
  tenants SaUserTenant[]

  @@unique([email])
  @@index([tenantId])
  @@index([role])
}

model SaUserTenant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   SaUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant SaTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model SaSession {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  refreshTokenHash String? @unique
  email      String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  refreshExpiresAt DateTime?
  refreshRotatedAt DateTime?
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([email, expiresAt])
  @@index([expiresAt])
}

model ApiToken {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  name       String
  tokenHash  String   @unique
  permissions String[]
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  tenant SaTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model SaModuleDefinition {
  key       String  @id
  name      String
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  toggles SaTenantModuleToggle[]
}

model SaTenantModuleToggle {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  moduleKey String
  enabled   Boolean @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant SaTenant @relation(fields: [tenantId], references: [id])
  module SaModuleDefinition @relation(fields: [moduleKey], references: [key])

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
}

model SaLimitDefinition {
  key        String       @id
  name       String
  periodType SaPeriodType
  moduleKey  String?
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([moduleKey])
}

model SaPlanDefinition {
  id                 String     @id @default(uuid()) @db.Uuid
  key                String     @unique
  name               String
  kind               SaPlanKind
  monthlyPriceInCents Int       @default(0)
  active             Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  services SaPlanServiceLimit[]
  tenantSnaps SaTenantPlanSnapshot[]
}

model SaPlanServiceLimit {
  id            String   @id @default(uuid()) @db.Uuid
  planId        String   @db.Uuid
  serviceKey    String
  isUnlimited   Boolean  @default(false)
  maxValue      Int?
  unitPriceInCents Int   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plan SaPlanDefinition @relation(fields: [planId], references: [id])

  @@unique([planId, serviceKey])
  @@index([serviceKey])
}

model SaTenantPlanSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  planId    String   @db.Uuid
  active    Boolean  @default(true)
  snapshot  Json
  startsAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant SaTenant @relation(fields: [tenantId], references: [id])
  plan   SaPlanDefinition @relation(fields: [planId], references: [id])

  @@index([tenantId, active])
  @@index([planId])
}

model SaUsageEvent {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  serviceKey String
  amount     Int
  periodType SaPeriodType
  periodKey  String
  source     String?
  meta       Json?
  createdAt  DateTime    @default(now())

  tenant SaTenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, periodKey])
  @@index([serviceKey, periodKey])
  @@index([createdAt])
}

model SaUsageCounter {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  serviceKey String
  periodKey  String
  total      Int      @default(0)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  tenant SaTenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, serviceKey, periodKey])
  @@index([tenantId, periodKey])
}

model SaBillingEvent {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  serviceKey    String
  quantity      Int
  unitPriceInCents Int
  totalInCents  Int
  periodType    SaPeriodType
  periodKey     String
  meta          Json?
  createdAt     DateTime    @default(now())

  tenant SaTenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, periodKey])
  @@index([serviceKey, periodKey])
  @@index([createdAt])
}

model SaBillingCounter {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  serviceKey    String
  periodKey     String
  totalQuantity Int      @default(0)
  totalInCents  Int      @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  tenant SaTenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, serviceKey, periodKey])
  @@index([tenantId, periodKey])
}

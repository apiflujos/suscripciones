{
  // Los scripts de reparación no los importa ni el admin ni el worker, así que
  // no entraban en ningún typecheck: `prisma.billingCycle` (delegate inexistente)
  // sobrevivió a build, tests y deploy y solo habría fallado al ejecutarlo sobre
  // producción. Este proyecto existe para que eso no vuelva a pasar.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts"]
}
